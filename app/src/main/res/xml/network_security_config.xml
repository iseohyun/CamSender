<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- Trust the server's self-signed certificate for local network domains -->
        <domain includeSubdomains="true">local</domain>
        <!-- In a real scenario, you would list the IP or use a broader local scope if supported -->
        <trust-anchors>
            <certificates src="@raw/cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
